{
  "name": "festrun",
  "private": true,
  "version": "2.0.0",
  "description": "FestRun — an offline, host-run quiz board race for tech fests. Many balanced maps, department themes (ECE, CSE, Mech, Civil, EEE, Bio, Aero, AI…), projector view, no login or internet.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "maps": "tsx scripts/checkMaps.ts",
    "optimize": "tsx scripts/optimize.ts",
    "optimize:quick": "tsx scripts/optimize.ts --quick"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  },
  "license": "MIT"
}
